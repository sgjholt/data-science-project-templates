# docker compose build
# docker compose run --rm train                                 # default run
# docker compose run --rm train -m model=random_forest,logistic_regression   # sweep
# docker compose up mlflow                                      # UI at http://localhost:5000
#
# data/, outputs/, mlruns/ and conf/ are bind-mounted, so results land on the host
# and config edits apply without a rebuild.

x-volumes: &project-volumes
  - ./conf:/app/conf
  - ./data:/app/data
  - ./outputs:/app/outputs
  - ./mlruns:/app/mlruns

services:
  train:
    build: .
    image: {{ project_slug }}:latest
    volumes: *project-volumes

  mlflow:
    image: {{ project_slug }}:latest
    entrypoint:
      - mlflow
      - ui
      - --backend-store-uri=sqlite:///mlruns/mlflow.db
      - --host=0.0.0.0
      - --port=5000
    ports:
      - "5000:5000"
    volumes: *project-volumes
